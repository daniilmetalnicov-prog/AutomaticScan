# === PostgreSQL Configuration ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xkdrJZQA3!rp
POSTGRES_DB=automatic_scan_db
POSTGRES_PORT=5432

# === Database URL for Backend (FastAPI + asyncpg) ===
# Внутри Docker хост базы данных называется 'db' (имя сервиса в compose)
DATABASE_URL=postgresql+asyncpg://postgres:xkdrJZQA3!rp@db:5432/automatic_scan_db

# === Application Settings ===
APP_NAME=AutomaticScan
APP_VERSION=1.0.0
ENVIRONMENT=development

# === RedCheck & JWT Settings (Заполни реальными данными для сервера) ===
REDCHECK_URL=http://your-redcheck-ip:port
REDCHECK_LOGIN=admin
REDCHECK_PASSWORD=admin
JWT_SECRET=super-secret-key-for-jwt-tokens-change-it-in-prod